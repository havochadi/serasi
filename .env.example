# Copy this file to .env and fill it in. .env is ignored by git; never commit real keys.

# Turns on Ask Serasi and the dashboard's AI summary. Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Password for the MENDAKI staff dashboard, at least 12 characters.
ADMIN_PASSWORD=

# Optional settings (defaults shown)
# CLAUDE_MODEL=claude-opus-5-5
# PORT=8787
# HOST=127.0.0.1                    # use 0.0.0.0 on a hosting platform
# DATABASE_PATH=data/serasi.db
# TRUST_PROXY=0                     # set to 1 behind a proxy or load balancer that sets X-Forwarded-For
# SESSION_SECRET=                   # signs staff sessions; defaults to one derived from ADMIN_PASSWORD
# ASK_LIMIT_PER_IP=60               # Ask Serasi questions per IP address per 10 minutes
# WRITE_LIMIT_PER_IP=120            # shares, updates and deletions per IP address per 10 minutes
# AI_DAILY_LIMIT=2000               # AI requests per day across everyone, to cap spending
# MAX_RESULTS=20000                 # shared results the database accepts
